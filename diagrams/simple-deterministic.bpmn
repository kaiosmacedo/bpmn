<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://example.com/simple-deterministic">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Processo Determinístico" processRef="Process_1" />
  </bpmn:collaboration>

  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Registro" name="Atendente">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Registrar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analise" name="Analista">
        <bpmn:flowNodeRef>Task_Analisar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Aprovacao" name="Gerente">
        <bpmn:flowNodeRef>Task_Aprovar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Início">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Registrar" name="Registrar">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Analisar" name="Analisar">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Aprovar" name="Aprovar">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_1" name="Fim">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Registrar" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Registrar" targetRef="Task_Analisar" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Analisar" targetRef="Task_Aprovar" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Aprovar" targetRef="EndEvent_1" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="750" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Registro_di" bpmnElement="Lane_Registro" isHorizontal="true">
        <dc:Bounds x="190" y="60" width="720" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Analise_di" bpmnElement="Lane_Analise" isHorizontal="true">
        <dc:Bounds x="190" y="180" width="720" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Aprovacao_di" bpmnElement="Lane_Aprovacao" isHorizontal="true">
        <dc:Bounds x="190" y="300" width="720" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="242" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="245" y="145" width="30" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Registrar_di" bpmnElement="Task_Registrar">
        <dc:Bounds x="350" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Analisar_di" bpmnElement="Task_Analisar">
        <dc:Bounds x="520" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Aprovar_di" bpmnElement="Task_Aprovar">
        <dc:Bounds x="680" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="832" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="840" y="385" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="278" y="120" />
        <di:waypoint x="350" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="450" y="120" />
        <di:waypoint x="485" y="120" />
        <di:waypoint x="485" y="240" />
        <di:waypoint x="520" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="620" y="240" />
        <di:waypoint x="650" y="240" />
        <di:waypoint x="650" y="360" />
        <di:waypoint x="680" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="780" y="360" />
        <di:waypoint x="832" y="360" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
